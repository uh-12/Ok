    ValueDisplay.TextSize = 10
    ValueDisplay.BackgroundColor3 = Color3.fromRGB(235, 235, 245)
    ValueDisplay.Parent = Slider

    function RangeSliderManager:update_positions(with_animation)

        local min_percent = (self.min_value - settings.minimum_value) / (settings.maximum_value - settings.minimum_value)
        local max_percent = (self.max_value - settings.minimum_value) / (settings.maximum_value - settings.minimum_value)
        
        min_percent = math.clamp(min_percent, 0, 1)
        max_percent = math.clamp(max_percent, 0, 1)
        
        if with_animation then

            TweenService:Create(self.min_thumb, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                Position = UDim2.new(min_percent, 0, 0.5, 0)
            }):Play()
            
            TweenService:Create(self.max_thumb, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                Position = UDim2.new(max_percent, 0, 0.5, 0)
            }):Play()
            
            TweenService:Create(self.fill, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                Size = UDim2.new(max_percent - min_percent, 0, 1, 0),
                Position = UDim2.new(min_percent, 0, 0.5, 0)
            }):Play()
        else

            self.min_thumb.Position = UDim2.new(min_percent, 0, 0.5, 0)
            self.max_thumb.Position = UDim2.new(max_percent, 0, 0.5, 0)
            self.fill.Size = UDim2.new(max_percent - min_percent, 0, 1, 0)
            self.fill.Position = UDim2.new(min_percent, 0, 0.5, 0)
        end
        
        local rounded_min = settings.round_number and math.floor(self.min_value) or self.min_value
        local rounded_max = settings.round_number and math.floor(self.max_value) or self.max_value
        
        if settings.round_number then
            ValueDisplay.Text = string.format("%d, %d", rounded_min, rounded_max)
        else
            ValueDisplay.Text = string.format("%.3f, %.3f", rounded_min, rounded_max)
        end
        
        Library._config._flags[settings.flag.."_min"] = self.min_value
        Library._config._flags[settings.flag.."_max"] = self.max_value
        Config:save(game.GameId, Library._config)
        
        settings.callback(self.min_value, self.max_value)
    end

    local active_thumb = nil
    local is_dragging = false
    
    local function on_input_began(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        
        local mouse_pos = mouse.X - Drag.AbsolutePosition.X
        local total_width = Drag.Size.X.Offset
        
        local min_pixel = (RangeSliderManager.min_value - settings.minimum_value) / (settings.maximum_value - settings.minimum_value) * total_width
        local max_pixel = (RangeSliderManager.max_value - settings.minimum_value) / (settings.maximum_value - settings.minimum_value) * total_width
        
        local min_dist = math.abs(mouse_pos - min_pixel)
        local max_dist = math.abs(mouse_pos - max_pixel)
        
        if min_dist < 15 and min_dist < max_dist then
            active_thumb = "min"
            is_dragging = true
        elseif max_dist < 15 then
            active_thumb = "max"
            is_dragging = true
        end
    end
    
    local function on_input_changed(input)
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        if not active_thumb then return end
        
        local mouse_pos = math.clamp(mouse.X - Drag.AbsolutePosition.X, 0, Drag.Size.X.Offset)
        local percentage = mouse_pos / Drag.Size.X.Offset
        local new_value = settings.minimum_value + (settings.maximum_value - settings.minimum_value) * percentage
        
        if active_thumb == "min" then

            new_value = math.min(new_value, RangeSliderManager.max_value)
            new_value = math.max(new_value, settings.minimum_value)
            RangeSliderManager.min_value = new_value
        elseif active_thumb == "max" then

            new_value = math.max(new_value, RangeSliderManager.min_value)
            new_value = math.min(new_value, settings.maximum_value)
            RangeSliderManager.max_value = new_value
        end
        
        RangeSliderManager:update_positions(false)
    end
    
    local function on_input_ended(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if active_thumb then

            RangeSliderManager:update_positions(true)
        end
        active_thumb = nil
        is_dragging = false
    end
    
    Slider.InputBegan:Connect(on_input_began)
    UserInputService.InputChanged:Connect(on_input_changed)
    UserInputService.InputEnded:Connect(on_input_ended)
    
    if Library:flag_type(settings.flag.."_min", 'number') then
        RangeSliderManager.min_value = Library._config._flags[settings.flag.."_min"]
        RangeSliderManager.max_value = Library._config._flags[settings.flag.."_max"] or settings.max_value
    end

    task.spawn(function()
        task.wait()
        RangeSliderManager:update_positions(true)
    end)

    return RangeSliderManager
end

