				local function getColor()
					return Color3.fromHSV(ColorManager._h, ColorManager._s, ColorManager._v)
				end

				local function updateVisuals()
					Preview.BackgroundColor3 = getColor()
					SaturationValue.BackgroundColor3 = Color3.fromHSV(ColorManager._h, 1, 1)
					SVMarker.Position = UDim2.new(ColorManager._s, 0, 1 - ColorManager._v, 0)
					HueMarker.Position = UDim2.new(ColorManager._h, 0, 0.5, 0)
				end

				local function saveColor()
					Library._config._flags[settings.flag] = {
						H = ColorManager._h,
						S = ColorManager._s,
						V = ColorManager._v
					}
					if Config and Config.save then
						Config:save(game.GameId, Library._config)
					end
					if settings.callback then
						settings.callback(getColor())
					end
				end

				local draggingSV = false
				local draggingHue = false

				SaturationValue.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						draggingSV = true
						Library._blocking_drag = true
						SVMarker.Visible = true
					end
				end)

				HueBar.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						draggingHue = true
						Library._blocking_drag = true
						HueMarker.Visible = true
					end
				end)

				UserInputService.InputChanged:Connect(function(input)
					if input.UserInputType ~= Enum.UserInputType.MouseMovement then
						return
					end

					if draggingSV then
						ColorManager._s = math.clamp(
							(input.Position.X - SaturationValue.AbsolutePosition.X) / SaturationValue.AbsoluteSize.X,
							0,
							1
						)
						ColorManager._v = 1 - math.clamp(
							(input.Position.Y - SaturationValue.AbsolutePosition.Y) / SaturationValue.AbsoluteSize.Y,
							0,
							1
						)
						updateVisuals()

						if settings.callback then
							settings.callback(getColor())
						end
					end

					if draggingHue then
						ColorManager._h = math.clamp(
							(input.Position.X - HueBar.AbsolutePosition.X) / HueBar.AbsoluteSize.X,
							0,
							1
						)
						updateVisuals()

						if settings.callback then
							settings.callback(getColor())
						end
					end
				end)

				UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
						return
					end

					if draggingSV or draggingHue then
						draggingSV = false
						draggingHue = false
						Library._blocking_drag = false
						saveColor()
					end
				end)

				local expanded = false

				Row.MouseButton1Click:Connect(function()
					expanded = not expanded
					SVMarker.Visible = expanded
					HueMarker.Visible = expanded

					self._size = expanded and self._size + 90 or self._size - 90

					if ModuleManager._state then
						Module.Size = UDim2.new(1, -8, 0, 93 + self._size)
					end

					Options.Size = UDim2.new(1, -8, 0, self._size)

					TweenService:Create(Picker, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
						Size = UDim2.new(0, 207, 0, expanded and 90 or 0)
					}):Play()

					TweenService:Create(Arrow, TweenInfo.new(0.3), {
						Rotation = expanded and -90 or 90
					}):Play()
				end)

				updateVisuals()

				Library._config._flags[settings.flag] = {
					H = ColorManager._h,
					S = ColorManager._s,
					V = ColorManager._v
				}

				if settings.callback then
					settings.callback(getColor())
				end

				function ColorManager:Set(color)
					local h, s, v = color:ToHSV()
					ColorManager._h = h
					ColorManager._s = s
					ColorManager._v = v
					updateVisuals()
					saveColor()
				end

				function ColorManager:Get()
					return getColor()
				end

				return ColorManager
			end

