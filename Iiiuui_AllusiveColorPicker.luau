			function ModuleManager:create_colorpicker(settings: any)
				LayoutOrderModule = LayoutOrderModule + 1

				local ColorManager = {
					_h = 0,
					_s = 1,
					_v = 1
				}

				if Library._config._flags[settings.flag] then
					local saved = Library._config._flags[settings.flag]

					if type(saved) == "table" and saved.H ~= nil then
						ColorManager._h = saved.H
						ColorManager._s = saved.S
						ColorManager._v = saved.V
					elseif typeof(saved) == "Color3" then
						ColorManager._h, ColorManager._s, ColorManager._v = saved:ToHSV()
					elseif type(saved) == "table" then
						local r = saved.r or saved.R or saved[1] or 1
						local g = saved.g or saved.G or saved[2] or 0
						local b = saved.b or saved.B or saved[3] or 1

						if r > 1 or g > 1 or b > 1 then
							r, g, b = r / 255, g / 255, b / 255
						end

						ColorManager._h, ColorManager._s, ColorManager._v = Color3.new(
							math.clamp(r, 0, 1),
							math.clamp(g, 0, 1),
							math.clamp(b, 0, 1)
						):ToHSV()
					end
				elseif settings.color then
					ColorManager._h, ColorManager._s, ColorManager._v = settings.color:ToHSV()
